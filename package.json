{
  "name": "ecommerce-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Global e-commerce affiliate + marketplace platform",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "seed": "pnpm --filter @ecommerce/api seed",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "prettier": "^3.2.5",
    "turbo": "^2.3.0",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@9.1.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "pnpm": {
    "overrides": {
      "multer": ">=2.1.0",
      "js-yaml": ">=4.1.1",
      "ajv": ">=8.18.0",
      "file-type": ">=21.3.1",
      "lodash": ">=4.17.23"
    }
  }
}
