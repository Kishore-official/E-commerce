# ============================================
# E-commerce Platform Environment Variables
# ============================================

# Application
NODE_ENV=development
API_PORT=3000
API_PREFIX=api/v1
API_BASE_URL=http://localhost:3000

# Frontend URLs (CORS)
STOREFRONT_URL=http://localhost:3001
VENDOR_URL=http://localhost:3002
ADMIN_URL=http://localhost:3003

# Database (MongoDB Atlas)
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/E-commerce?appName=E-commerce
MONGODB_DB_NAME=E-commerce

# Auth (JWT)
JWT_SECRET=change-this-to-a-secure-secret
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# OpenSearch
OPENSEARCH_NODE=http://localhost:9200
OPENSEARCH_USERNAME=admin
OPENSEARCH_PASSWORD=admin

# Email Service
# Set to 'resend' for production, 'mock' for development
EMAIL_PROVIDER=mock
EMAIL_FROM=MERIDIAN <noreply@meridian.com>
RESEND_API_KEY=re_xxxxxxxxxxxxx

# SMS Service
# Set to 'msg91' for production, 'mock' for development
SMS_PROVIDER=mock
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_SENDER_ID=MRDIAN
MSG91_TEMPLATE_ID=your_msg91_template_id

# Payment Gateway
# Set to 'razorpay' for production, 'mock' for development
PAYMENT_GATEWAY=mock
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# File Storage
# Set to 's3' for production, 'gridfs' for development (no extra setup)
STORAGE_PROVIDER=gridfs

# S3-compatible storage (AWS S3, MinIO, DigitalOcean Spaces, Cloudflare R2)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=ecommerce
S3_REGION=us-east-1

# CDN URL (optional — for CloudFront, Cloudflare, etc.)
# If set, uploaded file URLs will use this as the base
CDN_URL=

# ============================================
# Frontend Environment Variables
# ============================================
# Set these in each app's .env.local file:
#
# apps/storefront/.env.local
#   NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
#
# apps/vendor/.env.local
#   NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
#
# apps/admin/.env.local
#   NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
#
# For production, replace localhost:3000 with your deployed API URL.
